          },
          {
            "id": "delete-hcc",
            "label": "Recommend HCC Deletion",
            "nextStatus": "Review",
            "auditDetail": "Recommended deletion because documentation did not substantiate the submitted HCC."
          }
        ]
      },
      {
        "id": "record-chase",
