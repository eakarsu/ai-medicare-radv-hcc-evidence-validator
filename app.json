        "description": "Determine whether each submitted HCC is supported by an acceptable date of service, diagnosis, signature, and face-to-face record.",
        "view": "evidence",
        "modules": [
          "hcc-validation",
          "record-inventory"
        ],
        "actions": [
          {
            "id": "substantiate-hcc",
